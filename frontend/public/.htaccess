# For the web version on Hostinger (app.trackseam.com).
# index.html must never be cached: it names the current hashed bundles, and a
# stale copy would point at files that a new upload removed.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
