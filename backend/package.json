{
  "name": "trackseam-backend",
  "version": "1.0.0",
  "description": "Trackseam REST API — Node.js + Express + MySQL (Prisma)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "migrate:mongo": "node scripts/migrate-from-mongo.js",
    "build:website": "node scripts/build-website.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.5",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "mongodb": "^6.21.0",
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=18.18"
  }
}
