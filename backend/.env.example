# Copy this file to .env and fill in your values. Never commit .env.

# MySQL (Aiven). Prisma reads connection_limit / pool_timeout from the URL.
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/trackseam_db?ssl-mode=REQUIRED&connection_limit=5&pool_timeout=20"

# Auth — use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Gmail account + app password used to send password-reset emails
MAIL_USER=
MAIL_PASS=

# Public base URL of this API; reset emails link to $PUBLIC_URL/reset-password
PUBLIC_URL=https://trackseam.onrender.com

# Extra browser origins allowed by CORS (comma-separated). The native app
# origins (capacitor://localhost, https://localhost) are always allowed.
CORS_ORIGINS=

# Shown on the privacy policy, terms and support pages
SUPPORT_EMAIL=contact@trackseam.com
LEGAL_ENTITY=Trackseam
GOVERNING_LAW=the Federal Republic of Nigeria

PORT=5000

# Only needed once, for scripts/migrate-from-mongo.js
MONGO_URI=
MONGO_DNS=
